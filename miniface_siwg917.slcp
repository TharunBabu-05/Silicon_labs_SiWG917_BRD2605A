# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: miniface_siwg917
label: MiniFace - SiWG917 Board Interface
description: |
  MiniFace is an interactive VCOM board interface for the SiWG917 BRD2605A.
  It provides on-demand Wi-Fi, audio analysis, LED control, and live board
  telemetry through a text-mode desktop.
category: IoT Application
filter:
- name: Capability
  value:
  - Wi-Fi
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Project Difficulty
  value:
  - Advanced
package: aiml_app
quality: production
readme:
- path: readme.md
source:
- path: voice_control_light.cc
- path: recognize_commands.cc
- path: app.cc
- path: config/audio_classifier_config.cc
include:
- path: .
  file_list:
  - path: app.h
  - path: voice_control_light.h
  - path: recognize_commands.h
  - path: led_helper.hpp
  - path: mic_helper.hpp
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2026.6.1
toolchain_settings:
- value: -Wno-unused-parameter
  option: gcc_compiler_option
- value: -Wall -Werror
  option: gcc_compiler_option
- value: -u _printf_float
  option: gcc_linker_option
- value: -Wall -Werror
  option: llvm_compiler_option
- value: -u _printf_float
  option: llvm_linker_option
- value: -Wno-implicit-exception-spec-mismatch
  option: llvm_compiler_option
- value: -mfp16-format=ieee
  option: gcc_compiler_option
- value: -Wno-unused-parameter
  option: gcc_compiler_option
